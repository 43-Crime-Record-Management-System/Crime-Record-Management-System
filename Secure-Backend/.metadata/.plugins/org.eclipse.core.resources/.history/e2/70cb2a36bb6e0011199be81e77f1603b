server.port=${PORT:9000}

spring.application.name=API_GATEWAY

eureka.client.service-url.defaultZone=${EUREKA_SERVER_URL:http://eureka-server:8761/eureka}
spring.cloud.gateway.routes[0].id=fir-service
spring.cloud.gateway.routes[0].uri=lb://FIRSERVICES
spring.cloud.gateway.routes[0].predicates[0]=Path=/firservices/**
spring.cloud.gateway.routes[0].filters[0]=RewritePath=/firservices/(?<segment>.*), /${segment}

# Duty Service Route
spring.cloud.gateway.routes[1].id=duty-service
spring.cloud.gateway.routes[1].uri=lb://DUTYSERVICES
spring.cloud.gateway.routes[1].predicates[0]=Path=/duty/**
spring.cloud.gateway.routes[2].id=auth-service
spring.cloud.gateway.routes[2].uri=lb://AUTHSERVICES
spring.cloud.gateway.routes[2].predicates[0]=Path=/authservices/**
